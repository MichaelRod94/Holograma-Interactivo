# Copia este archivo a .env (ignorado por git) y complétalo con tus valores.
# La Api lee .env al arrancar (lo busca en su carpeta y hacia arriba); en un servidor, las variables de entorno
# reales tienen prioridad sobre el archivo. Formato: CLAVE=valor, una por línea.
# Solo se admiten comentarios en líneas propias que empiezan con #. Las claves sin valor se ignoran.
# En .NET, "__" equivale a ":" (GenerativeAi__ApiKey es la clave GenerativeAi:ApiKey).

# PostgreSQL local (F2). Pon aquí la contraseña real solo en tu .env, nunca en este archivo.
ConnectionStrings__Holograma3D=Host=localhost;Port=5432;Database=holograma3d;Username=holograma3d;Password=

# IA generativa imagen -> 3D (F7). Meshy | Http | Fake. Vacío = generación deshabilitada.
GenerativeAi__Provider=Fake
# https://api.meshy.ai para Meshy, o la URL de tu servidor propio para Http.
GenerativeAi__BaseUrl=
# Clave del proveedor. Es un secreto: solo en el .env o en una variable de entorno del servidor, nunca en git.
GenerativeAi__ApiKey=
# Opcional: versión del modelo del proveedor (en Meshy, ai_model: latest, meshy-6-lite...).
GenerativeAi__Model=
# Formato que se pide y se guarda en el catálogo: glb | stl.
GenerativeAi__OutputFormat=glb
# false en el MVP: mallas sin textura (sin color).
GenerativeAi__Texture=false
# Fotos por generación (Meshy admite de 1 a 4).
GenerativeAi__MaxImages=4
# Cada cuántos segundos se consulta el estado de los trabajos.
GenerativeAi__PollSeconds=5
# Minutos antes de dar un trabajo por fallido.
GenerativeAi__TimeoutMinutes=15
# Triángulos objetivo de la malla generada.
GenerativeAi__TargetPolycount=30000
# Trabajos de IA simultáneos por usuario.
GenerativeAi__MaxActiveJobsPerUser=3

# URL del Display que va en el QR. Vacía = IP LAN detectada, puerto 5082.
PublicDisplayUrl=
# Orígenes permitidos fuera de Development (uno por índice: __0, __1...).
Cors__Origins__0=
